#version 450 core
layout(local_size_x = 3, local_size_y = 1, local_size_z = 1) in;

struct Vertex {
    vec2 pos;
    vec3 color;
};

layout(std430, binding = 0) buffer PosBuffer {
    Vertex vertices[];
};

uniform float u_angle;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    // 初始三角形基准坐标 (静止状态)
    vec2 basePos[3];
    basePos[0] = vec2( 0.0,  0.5);
    basePos[1] = vec2(-0.5, -0.5);
    basePos[2] = vec2( 0.5, -0.5);

    if (idx < 3) {
        vec2 p = basePos[idx];
        // 2D 旋转矩阵计算: x' = x*cos - y*sin, y' = x*sin + y*cos
        float cosA = cos(u_angle);
        float sinA = sin(u_angle);

        vertices[idx].pos = vec2(
            p.x * cosA - p.y * sinA,
            p.x * sinA + p.y * cosA
        );

        vertices[idx].color = vec3(1.0, 0.0, 0.0); // 红色
    }
}
