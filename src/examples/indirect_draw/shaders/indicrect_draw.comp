#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct FrustumPlane {
    vec3 normal;
    float d;
};

struct GPUInstanceData {
    mat4 worldMatrix;
    vec4 boundingSphere;
    uint meshID;
    uint materialID;
    uint padding[2];
};

// OpenGL DrawElementsIndirectCommand 映射结构体
struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    int baseVertex;
    uint baseInstance;
};

// SSBO 0: 全量 Instance 库
layout(std430, binding = 0) readonly buffer InstanceBuffer {
    GPUInstanceData instances[];
};

// SSBO 2: 可见物体的 realInstanceID 压缩列表
layout(std430, binding = 2) writeonly buffer VisibleInstanceBuffer {
    uint visibleInstanceIDs[];
};

// SSBO 3: 将 Indirect Command Buffer 绑定为 Storage Buffer (便于 CS 写入)
layout(std430, binding = 3) buffer IndirectCommandBuffer {
    DrawElementsIndirectCommand command;
};

uniform uint u_TotalInstances;
layout (std140, binding = 0) uniform FrustumBlock {
    FrustumPlane u_FrustumPlanes[6];
};

bool IsSphereInFrustum(vec3 center, float radius) {
    for (int i = 0; i < 6; ++i) {
        if (dot(u_FrustumPlanes[i].normal, center) + u_FrustumPlanes[i].d < -radius) {
            return false;
        }
    }
    return true;
}

void main() {
    uint gID = gl_GlobalInvocationID.x;

    if (gID >= u_TotalInstances) return;

    GPUInstanceData instance = instances[gID];

    // 获取物体世界坐标下的包围球
    vec3 sphereCenter = instance.boundingSphere.xyz;
    float sphereRadius = instance.boundingSphere.w;

    // 执行视锥剔除测试
    if (IsSphereInFrustum(sphereCenter, sphereRadius)) {
        // 直接在 command.instanceCount 上做原子加法！
        // writeIndex 即为该物体在 visibleInstanceIDs 数组里的连续写入位置
        uint writeIndex = atomicAdd(command.instanceCount, 1);
        visibleInstanceIDs[writeIndex] = gID;
    }
}
